{
  "name": "lago-billing-simulator-poc",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "node --test 'test/*.test.ts'",
    "lago:up": "docker compose --project-directory lago up -d --wait db redis api api-worker api-clock front",
    "lago:down": "docker compose --project-directory lago down",
    "lago:reset": "docker compose --project-directory lago down -v",
    "simulate": "node --env-file=lago/.env src/main.ts",
    "probe": "node --env-file=lago/.env src/probe.ts"
  }
}
